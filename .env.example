# =====================================================================
# ARUNA AI - environment template
# Copy to .env and fill in.  NEVER commit .env  (SPEC 43)
# =====================================================================

# ---------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------
ARUNA_ENV=development                 # development | staging | production
ARUNA_INSTANCE_NAME=aruna-local
ARUNA_TIMEZONE=Asia/Jakarta

# SPEC 46: real trading is DISABLED for the MVP.  Setting this to true is
# rejected at startup in PHASE 1 - execution has not been built or validated.
ARUNA_REAL_TRADING_ENABLED=false

# SPEC 34: paper trading only.
ARUNA_PAPER_TRADING_ENABLED=true

# Markets this instance runs.  Comma separated.  Allowed: CRYPTO, IDX
# (SPEC: forex is removed entirely - "FOREX" is rejected at startup)
ARUNA_ENABLED_MARKETS=CRYPTO,IDX

# ---------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------
ARUNA_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
ARUNA_LOG_FORMAT=console              # console | json
ARUNA_LOG_DIR=logs
ARUNA_LOG_FILE_ENABLED=true

# ---------------------------------------------------------------------
# MYSQL  (MySQL 8.0.16+ required: the schema uses CHECK constraints)
# Laragon's bundled MySQL defaults to user root with an empty password.
# ---------------------------------------------------------------------
ARUNA_DB_HOST=127.0.0.1
ARUNA_DB_PORT=3306
ARUNA_DB_NAME=aruna
ARUNA_DB_USER=root
ARUNA_DB_PASSWORD=
ARUNA_DB_MIN_POOL=1
ARUNA_DB_MAX_POOL=10
ARUNA_DB_CONNECT_TIMEOUT_SEC=10
ARUNA_DB_COMMAND_TIMEOUT_SEC=30

# ---------------------------------------------------------------------
# REDIS  (optional - ARUNA degrades gracefully when unreachable)
# ---------------------------------------------------------------------
ARUNA_REDIS_ENABLED=true
ARUNA_REDIS_HOST=127.0.0.1
ARUNA_REDIS_PORT=6379
ARUNA_REDIS_DB=0
ARUNA_REDIS_PASSWORD=
ARUNA_REDIS_NAMESPACE=aruna

# ---------------------------------------------------------------------
# TELEGRAM  (SPEC 21, 40, 41)
# ---------------------------------------------------------------------
# Leave the token empty to run ARUNA with Telegram disabled.
ARUNA_TELEGRAM_ENABLED=true
ARUNA_TELEGRAM_BOT_TOKEN=
# Chat id that receives signals / reports / health alerts.
ARUNA_TELEGRAM_CHAT_ID=
# Comma separated chat ids allowed to issue commands.  Empty = only CHAT_ID.
ARUNA_TELEGRAM_ALLOWED_CHAT_IDS=
ARUNA_TELEGRAM_ALERT_ON_HEALTH_CHANGE=true

# ---------------------------------------------------------------------
# HEALTH MONITOR
# ---------------------------------------------------------------------
ARUNA_HEALTH_INTERVAL_SEC=30
ARUNA_HEALTH_DB_TIMEOUT_SEC=5
ARUNA_HEALTH_REDIS_TIMEOUT_SEC=3
ARUNA_HEALTH_TELEGRAM_TIMEOUT_SEC=10
# Consecutive failures before a component is reported DOWN.
ARUNA_HEALTH_FAILURE_THRESHOLD=2

# ---------------------------------------------------------------------
# DATA PROVIDERS
#
# Leave a provider blank to disable that market; ARUNA then reports
# STATUS: DATA SOURCE UNAVAILABLE for it rather than substituting
# another source (SPEC 4).
# ---------------------------------------------------------------------

# Crypto. Supported: binance-spot  (the only one - see below)
#
# binance-spot serves USDT pairs (BTC/USDT, ETH/USDT, SOL/USDT) over public
# REST endpoints, no credentials, read-only. Binance is NOT registered with
# Bappebti - a legal fact the adapter records on every row (SPEC 47), and the
# operator decides whether it fits the deployment's jurisdiction.
#
# A previous note here said Binance was unreachable from Indonesia because its
# domains resolve to the Kominfo TrustPositif block page. That was one
# measurement on one network; on 2026-08-17 api.binance.com, api1 and api2 all
# answered from this machine. If a network does block it, `aruna providers`
# reports UNREACHABLE with the transport error - it is not assumed either way.
#
# There is deliberately no second crypto adapter. PASAL 5 forbids a fallback,
# and a registered alternative is a fallback - one edited line away from being
# selected. If Binance cannot be reached, ARUNA says so and stops; it does not
# quote a different venue's prices under the same symbol.
#
# Leaving this blank disables crypto entirely. Any other value is refused at
# startup with the list of registered names.
ARUNA_CRYPTO_PROVIDER=binance-spot
# There is deliberately no ARUNA_CRYPTO_PROVIDER_API_KEY or _API_SECRET here.
# The Binance spot adapter calls public market-data endpoints only; it holds no
# key and signs nothing, and PASAL 41 forbids a trading API outright. The two
# slots used to sit on this line, kept on the argument that Settings.secrets
# feeds the log redactor. That argument did not hold - config.py sets
# extra="ignore", so a variable with no field behind it is never loaded into the
# process, and a value ARUNA never reads is a value ARUNA cannot print. What a
# named slot does instead is invite a real Binance key into a system that has no
# execution path to use it, so the slots were removed rather than left blank.

# IDX equities. Supported: yahoo
# Unofficial and DELAYED. Yahoo's terms permit personal, non-commercial use.
ARUNA_IDX_PROVIDER=yahoo
ARUNA_IDX_PROVIDER_API_KEY=

# News: RSS feeds (Kontan, CNBC Indonesia, Detik, CoinDesk, Cointelegraph).
ARUNA_NEWS_PROVIDER=rss
ARUNA_NEWS_PROVIDER_API_KEY=

# Fundamentals: Yahoo via yfinance. Unofficial; personal, non-commercial use.
ARUNA_FUNDAMENTAL_PROVIDER=yahoo
ARUNA_FUNDAMENTAL_PROVIDER_API_KEY=

# ---------------------------------------------------------------------
# DATA INGESTION AND QUALITY THRESHOLDS  (SPEC 5)
# ---------------------------------------------------------------------
ARUNA_DATA_POLL_INTERVAL_SEC=5
ARUNA_DATA_TICK_SAMPLE_SEC=5
ARUNA_DATA_BACKFILL_CANDLES=500
ARUNA_DATA_REQUEST_TIMEOUT_SEC=15
ARUNA_DATA_MAX_RETRIES=3

# A quote older than this is STALE. IDX is judged separately because that
# feed is delayed by design.
ARUNA_DATA_STALE_TICK_SEC=60
ARUNA_DATA_STALE_IDX_TICK_SEC=300
ARUNA_DATA_MAX_SPREAD_BPS=200
ARUNA_DATA_MAX_PRICE_JUMP_PCT=10
ARUNA_DATA_LATENCY_SPIKE_MS=5000
# Sized for clock skew between ARUNA and a venue, not for leakage.
ARUNA_DATA_FUTURE_TOLERANCE_SEC=30
# Assumed IDX feed delay. Yahoo does not declare the real figure for Jakarta
# symbols, so this is a floor - the true delay may be larger, never smaller.
ARUNA_DATA_IDX_DECLARED_DELAY_SEC=900

# ---------------------------------------------------------------------
# UPKEEP LOOP - candle refresh + signal resolution
# ---------------------------------------------------------------------
# Only `aruna run` starts this loop. One-shot CLI commands never do, and
# `aruna upkeep` runs exactly one cycle by hand.
#
# There is no cadence setting on purpose: every interval is refreshed once
# per bar, just after that bar closes (1m each minute, 15m at :00/:15/:30/
# :45, 1h on the hour, 1d after 00:00 UTC). Turn this off to stop the
# maintenance work without also stopping the 5-second quote poll.
ARUNA_UPKEEP_ENABLED=true

# How often the loop wakes to see what is due. An idle wake-up costs no
# provider request at all.
ARUNA_UPKEEP_TICK_SEC=15

# Wait this long after a bar boundary before pulling it - a bar requested at
# exactly :00 is often not final yet at the venue.
ARUNA_UPKEEP_CANDLE_SETTLE_SEC=15

# Bars per routine refresh: one still forming plus two closed. How far behind
# the series really is decides catch-up, measured from the newest stored bar.
ARUNA_UPKEEP_CANDLE_OVERLAP_BARS=3

# Ceiling on a catch-up pull. Anything still missing beyond it is reported as
# a gap, never filled in (SPEC 4).
ARUNA_UPKEEP_CANDLE_MAX_BARS=500

# Minimum spacing between retries of an interval that just failed. Without it
# one failed daily pull would wait 24 hours for its next chance.
ARUNA_UPKEEP_CANDLE_RETRY_SEC=60

# Hard ceiling on provider requests per cycle. Work over the ceiling is
# deferred to the next tick, not dropped.
ARUNA_UPKEEP_MAX_REQUESTS_PER_CYCLE=40

# Empty = derived per market from the intervals outcome sampling actually
# reads (CRYPTO: 1m,15m,1h,1d - IDX: 15m,1h,1d). Set it by hand only when
# locking signals on horizons whose own evidence must stay fresh too,
# e.g. 15m,30m,1h,4h,1d
ARUNA_UPKEEP_CANDLE_INTERVALS=

# Resolution can be paused without stopping the candle refresh.
ARUNA_UPKEEP_RESOLVE_ENABLED=true
ARUNA_UPKEEP_RESOLVE_INTERVAL_SEC=60
# Not 50: due signals are read oldest-first, so unscoreable ones sit at the
# head of the queue and a small limit is spent entirely on them.
ARUNA_UPKEEP_RESOLVE_LIMIT=100

# Health threshold for candles:<MARKET> - a bar older than this many
# interval-lengths is reported. Below 2x it blinks on every hiccup.
ARUNA_UPKEEP_STALE_TOLERANCE_FACTOR=3
